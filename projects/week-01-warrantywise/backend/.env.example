# WarrantyWise Environment Configuration

# Application settings
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Database: default uses SQLite
DATABASE_URL=sqlite+aiosqlite:///./warrantywise.db

# Storage directory for uploaded receipts
UPLOAD_DIR=./uploads

# AI Extractor Provider: "gemini", "openai", or "mock" (offline rule-based)
AI_PROVIDER=mock

# Gemini API Key (Required if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI / OpenRouter API Key (Required if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
